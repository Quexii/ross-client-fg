  "refmap": "ross.mixins.refmap.json",
  "mixins": [
    "minecraft.entity.MixinEntity",
    "minecraft.entity.MixinEntityLivingBase",
    "minecraft.network.MixinNetworkManager",
    "minecraft.util.MixinMovementInputFromOptions"
  ],
  "client": [
